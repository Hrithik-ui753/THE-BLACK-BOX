# Application Configuration
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
DEFAULT_BATTERY_ID=164de9f0-62ee-411a-b8b9-a73eb2406f97

# Supabase Configuration
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your-supabase-key
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Firebase Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_DATABASE_URL=https://your-firebase-project-default-rtdb.firebaseio.com/
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-firebase-private-key\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your-firebase-client-email@your-project.iam.gserviceaccount.com

# Twilio SMS & WhatsApp Configuration
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_SMS_FROM=+10000000000
TWILIO_SMS_TO=+910000000000
TWILIO_WHATSAPP_FROM=whatsapp:+10000000000
TWILIO_WHATSAPP_TO=whatsapp:+910000000000
TWILIO_CONTENT_SID=your-twilio-content-sid

# Email Alert Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password
ALERT_RECIPIENT_EMAIL=recipient-email@gmail.com

# Azure OpenAI AI Chatbot Configuration
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-azure-openai-resource.services.ai.azure.com/openai/v1/responses
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
