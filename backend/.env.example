# THE BLACK BOX - Backend Environment Configuration Example
# Copy this file to backend/.env and replace placeholders with actual credentials.

# Default Battery Unit ID
DEFAULT_BATTERY_ID=164de9f0-62ee-411a-b8b9-a73eb2406f97

# Firebase RTDB & Project Configuration
FIREBASE_DATABASE_URL=https://black-box-9aa5e-default-rtdb.firebaseio.com/
FIREBASE_PROJECT_ID=black-box-9aa5e
# FIREBASE_SERVICE_ACCOUNT_JSON=your_service_account_json_string_here

# Supabase Database Configuration
SUPABASE_URL=https://umfifxbyykzxzodocgtm.supabase.co
SUPABASE_KEY=your_supabase_key_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# Azure OpenAI LLM Assistant Configuration
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini

# Automatic Gmail Alerting SMTP Configuration
GMAIL_USER=your_gmail_address_here
GMAIL_APP_PASSWORD=your_gmail_app_password_here
ALERT_RECIPIENT_EMAIL=your_alert_recipient_email_here

# Polling & Safety Thresholds
POLL_INTERVAL_SECONDS=3.0
CELL_ABSENT_THRESHOLD=0.15
